{
  "name": "terrain-npm-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "terrain-npm-workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@terrain-ai/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@terrain-ai/cli-darwin-arm64": {
      "resolved": "packages/cli-darwin-arm64",
      "link": true
    },
    "node_modules/@terrain-ai/rtk": {
      "resolved": "packages/rtk",
      "link": true
    },
    "node_modules/@terrain-ai/rtk-darwin-arm64": {
      "resolved": "packages/rtk-darwin-arm64",
      "link": true
    },
    "packages/cli": {
      "name": "@terrain-ai/cli",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "terrain": "bin/terrain.js"
      },
      "engines": {
        "node": ">=18"
      },
      "optionalDependencies": {
        "@terrain-ai/cli-darwin-arm64": "0.1.0"
      }
    },
    "packages/cli-darwin-arm64": {
      "name": "@terrain-ai/cli-darwin-arm64",
      "version": "0.1.0",
      "cpu": [
        "arm64"
      ],
      "license": "MIT",
      "os": [
        "darwin"
      ],
      "bin": {
        "terrain": "bin/terrain"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/rtk": {
      "name": "@terrain-ai/rtk",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "rtk": "bin/rtk.js"
      },
      "engines": {
        "node": ">=18"
      },
      "optionalDependencies": {
        "@terrain-ai/rtk-darwin-arm64": "0.1.0"
      }
    },
    "packages/rtk-darwin-arm64": {
      "name": "@terrain-ai/rtk-darwin-arm64",
      "version": "0.1.0",
      "cpu": [
        "arm64"
      ],
      "license": "MIT",
      "os": [
        "darwin"
      ],
      "bin": {
        "rtk": "bin/rtk"
      },
      "engines": {
        "node": ">=18"
      }
    }
  }
}
