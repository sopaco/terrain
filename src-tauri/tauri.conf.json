{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terrain",
  "version": "0.9.2",
  "identifier": "com.terrain.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Terrain",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/rtk", "binaries/terrain-cli"],
    "resources": {
      "bundled-resources/codegraph": "tools/codegraph",
      "../preset_skills": "preset_skills"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
