{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability for Terrain",
  "windows": ["main", "usage"],
  "remote": {
    "urls": ["http://localhost:1420"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "shell:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/rtk",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/terrain-cli",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
